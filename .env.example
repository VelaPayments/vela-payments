# Vela API base URL (include the /v1 prefix)
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
EXPO_PUBLIC_WEBAUTHN_RP_ID=dingpayments.app

# Supabase Auth public client settings (never use the service role key here)
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stellar Network Settings ("testnet" or "mainnet")
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Node Configuration Endpoints
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Asset Constraints & Anchors
